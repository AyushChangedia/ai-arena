# Every environment variable the engine and web app read (SPEC §7.1).
# Copy to .env only for local development against a local database. Never commit real values.
# Production values live in GitHub Actions secrets (engine) and Vercel environment variables (web).

# Neon owner role. Used only by migrate.yml to run migrations and create roles.
DATABASE_URL_OWNER=
# Neon role engine_rw (created by migration; set its password in the Neon console). Used by the engine.
DATABASE_URL=
# Neon role web_ro (created by migration). Used by the web app only.
DATABASE_URL_READONLY=
# openrouter.ai → Keys. Set a credit limit on the key.
OPENROUTER_API_KEY=
# smartapi.angelone.in → create an app (choose market data if offered).
ANGEL_API_KEY=
# Angel One client ID.
ANGEL_CLIENT_CODE=
# Angel One MPIN (the API login uses the MPIN, not the web password).
ANGEL_MPIN=
# Base32 secret shown when enabling TOTP for SmartAPI.
ANGEL_TOTP_SECRET=
# Vercel production URL (from Phase 5).
WEB_BASE_URL=
# Random string of 32+ characters, shared by the engine and the web app (from Phase 5).
REVALIDATE_SECRET=
# Optional: Telegram alerts (@BotFather, then message the bot and read the chat ID).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Optional: healthchecks.io ping URL (dead-man's switch).
HEALTHCHECKS_PING_URL=
# shadow or live.
ARENA_MODE=shadow
